# @owner HUB · BeWise API routing (Apache / LiteSpeed on Hostinger)
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS (this folder's rules replace the site-level ones)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # pass the Authorization header through to PHP
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # code, data and private files are never served directly
  RewriteRule ^(lib|modules|migrations|seed|storage|tests)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  # everything that isn't a real file (sdk/*.js, install.php) goes to the API
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
</IfModule>
<FilesMatch "\.(sql|json|md|sh|log)$">
  Require all denied
</FilesMatch>
