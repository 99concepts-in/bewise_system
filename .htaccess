# BeWise — whole-site config for Hostinger (Apache / LiteSpeed).  @owner HUB
#  is replaced by hosting/build-hostinger-site.sh ("" for a domain root, "/folder" for a sub-folder).
# The client app has its own .htaccess in /client (caching, camera permission, 404).
Options -Indexes
DirectoryIndex index.html
DirectorySlash On

RewriteEngine On
# HTTPS everywhere (camera in the client app needs a secure origin)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Prototype with sample data: keep it out of search engines
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(html|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2?|js|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
