{
  "$comment": "BeWise Wellness design tokens — single source of truth. Owner: HUB. Brand guide §3, §4, §10. Changing primary navy, logo or core fonts requires owner approval (brand guide §12).",
  "color": {
    "brand": {
      "navy": "#263C78",
      "navy-deep": "#182957",
      "ivory": "#FAF9F5",
      "white": "#FFFFFF",
      "sage": "#82977E",
      "sage-soft": "#DCE7D9",
      "beige": "#EDE5D9",
      "gold": "#B89B64"
    },
    "derived": {
      "navy-hover": "#1F3266",
      "navy-tint": "#E8ECF5",
      "sage-hover": "#6F8569",
      "sage-text": "#4F6249",
      "gold-text": "#7F6A3F",
      "ink": "#1B2238",
      "ink-muted": "#5B6275",
      "ink-subtle": "#8A90A0",
      "border": "#E4E1D8",
      "border-strong": "#CFCBBF",
      "surface-sunken": "#F3F1EA"
    },
    "status": {
      "$comment": "Always pair colour with an icon + text label (brand guide §3: don't rely on colour alone).",
      "success": { "fg": "#2F6B3A", "bg": "#E3EFE0", "icon": "check-circle" },
      "info": { "fg": "#263C78", "bg": "#E8ECF5", "icon": "info" },
      "warning": { "fg": "#8A5A00", "bg": "#FBEFD6", "icon": "clock" },
      "danger": { "fg": "#A3322B", "bg": "#F8E3E1", "icon": "alert-triangle" },
      "neutral": { "fg": "#5B6275", "bg": "#EEEDE8", "icon": "circle" }
    },
    "space-accent": {
      "$comment": "Each role space keeps navy as anchor but gets a subtle accent so multi-role users always know where they are.",
      "public": "#82977E",
      "client": "#82977E",
      "consultant": "#82977E",
      "manager": "#263C78",
      "owner": "#B89B64",
      "personal-finance": "#EDE5D9"
    },
    "chart": {
      "$comment": "Limited accessible palette (brand guide §10). Series order is fixed across the app.",
      "series": ["#263C78", "#82977E", "#C9B48A", "#5E7FB8", "#B7C7B3", "#182957"],
      "positive": "#2F6B3A",
      "negative": "#A3322B",
      "grid": "#E4E1D8"
    }
  },
  "font": {
    "display": "'Cormorant Garamond', 'Times New Roman', serif",
    "ui": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "numeric-feature": "tnum 1, lnum 1"
  },
  "type-scale": {
    "$comment": "Restrained scale. Display = Cormorant Garamond (600). Everything else = Inter.",
    "display-xl": { "size": "48px", "line": "56px", "font": "display", "weight": 600 },
    "display-lg": { "size": "36px", "line": "44px", "font": "display", "weight": 600 },
    "display-md": { "size": "28px", "line": "36px", "font": "display", "weight": 600 },
    "title": { "size": "20px", "line": "28px", "font": "ui", "weight": 600 },
    "subtitle": { "size": "16px", "line": "24px", "font": "ui", "weight": 600 },
    "body": { "size": "15px", "line": "24px", "font": "ui", "weight": 400 },
    "body-sm": { "size": "13px", "line": "20px", "font": "ui", "weight": 400 },
    "label": { "size": "13px", "line": "16px", "font": "ui", "weight": 500 },
    "overline": { "size": "11px", "line": "16px", "font": "ui", "weight": 600, "tracking": "0.12em", "case": "upper" },
    "money-lg": { "size": "28px", "line": "34px", "font": "ui", "weight": 600, "numeric": "tabular" }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "12px", "xl": "16px", "pill": "999px" },
  "shadow": {
    "card": "0 1px 2px rgba(24,41,87,0.04), 0 2px 8px rgba(24,41,87,0.05)",
    "raised": "0 4px 16px rgba(24,41,87,0.08)",
    "overlay": "0 12px 40px rgba(24,41,87,0.16)"
  },
  "border": { "hairline": "1px solid #E4E1D8" },
  "motion": {
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "duration-slow": "320ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "$comment": "Respect prefers-reduced-motion: disable non-essential animation."
  },
  "layout": {
    "touch-target-min": "44px",
    "mobile-gutter": "16px",
    "content-max": "1200px",
    "reading-max": "680px",
    "sidebar-width": "248px",
    "rail-width": "84px",
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" }
  }
}
